{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#config/*": "./dist/config/*",
    "#shared/*": "./dist/shared/*",
    "#resources/*": "./dist/resources/*",
    "#plugins/*": "./dist/plugins/*"
  },
  "scripts": {
    "dev": "tsx watch --ignore \"**/node_modules/**\" --clear-screen=false src/index.ts",
    "dev:once": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome check src/",
    "format": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.1",
    "@better-auth/mongo-adapter": "^1.7.1",
    "@classytic/arc": "^2.34.0",
    "@classytic/ca-tax": "^0.0.1",
    "@classytic/fin-io": "^0.6.7",
    "@classytic/ledger-ca": "^0.5.0",
    "@classytic/mongokit": "^3.34.0",
    "@classytic/primitives": "^0.23.0",
    "@classytic/repo-core": "^0.24.0",
    "@classytic/tax-core": "^0.3.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/under-pressure": "^9.1.0",
    "@spinekit/auth": "^0.5.0",
    "@spinekit/kit": "^0.1.1",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@fastify/jwt": "^10.2.1",
    "@types/node": "^22.10.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
