# TaxFoundry API — environment
#
# Copy to `.env.local` for local development, or set these in your host's
# environment for a deployment. Every file matching `.env*` is gitignored
# except this one, so a real secret cannot be committed by accident.
#
# Load order (Next.js-style): .env.local → .env.production / .env.development
# → .env. Anything already in the process environment wins over all of them.

# ─────────────────────────────────────────────────────────────────────────────
# Required — the server will not run correctly without these
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8040
HOST=0.0.0.0

# The tax data. Use a dedicated database, not one shared with another app —
# returns are retained for six years and must not be co-mingled.
MONGODB_URI=mongodb://localhost:27017/taxfoundry

# Minimum 32 characters. Generate with: openssl rand -base64 32
# A DIFFERENT value per environment: sharing it between staging and production
# means a staging session token is valid in production.
BETTER_AUTH_SECRET=your-32-character-minimum-secret-here

# Where the browser reaches this API. Must be the PUBLIC URL in a deployment,
# not localhost — it is used to build callback URLs.
BETTER_AUTH_URL=http://localhost:8040

# Where the frontend is served from.
FRONTEND_URL=http://localhost:3000

# Shared parent domain for the session cookie. REQUIRED whenever the frontend
# and this API are on different hosts (e.g. example.com + be.example.com):
# Better Auth's cookies are host-only without it, so the frontend never receives
# the session and every sign-in appears to succeed and then bounces back to the
# login page. Leave it UNSET for a single-host deployment and for local dev —
# localhost needs a host-only cookie, and a Domain the browser cannot match
# drops the cookie entirely. Both hosts above are checked against this at boot.
# COOKIE_DOMAIN=.example.com

# The frontend calls this API cross-origin (there is no proxy), so its exact
# origin must be listed. `*` is accepted but never appropriate in production:
# these responses carry tax data.
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# Multi-tenant request header carrying the organization id.
ORG_HEADER=x-organization-id

# Google sign-in. Both must be set for the provider to be enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Filing — leave EVERYTHING here unset until certified
# ─────────────────────────────────────────────────────────────────────────────
#
# With no endpoint configured the filing gateway keeps a stub that refuses with
# 503. That is the safe default and the reason it is the default: no
# environment can record a return as transmitted that was never sent.
#
# Alberta issues an approval code at certification. A return filed without a
# valid one is REJECTED and must be re-filed, so this is part of the payload
# rather than paperwork.

# Alberta AT1 Net File — the only jurisdiction whose wire format is published.
# TRA_NETFILE_ENDPOINT=https://<host>/CITNetFile-PublicWebServices-context-root/CITReturnFilingSoap12HttpPort
# TRA_NETFILE_TIMEOUT_MS=60000

# Transmitter identity, printed on the AT1 EDI schedule. TRA issues the
# software certification code; the placeholder is used until then.
# TRA_SOFTWARE_CERT_CODE=AB0000
# TRA_WS_VERSION=0.0.1
# TRA_SERIAL=SR_DEV
# TRANSMITTER_LEGAL_NAME=
# TRANSMITTER_EMAIL=
# TRANSMITTER_CONTACT_FIRST=
# TRANSMITTER_CONTACT_LAST=
# TRANSMITTER_PHONE=

# Federal and Québec software codes, issued at their respective certifications.
# Neither jurisdiction publishes its filing schema beforehand, so these stay
# unset and both renderers produce a clearly-marked draft.
# CRA_T2_SOFTWARE_CODE=
# RQ_CO17_SOFTWARE_CODE=

# Reported in the transmitter block; defaults to the package version.
# TAXFOUNDRY_VERSION=
