# Environment Files (Next.js-style priority):
#   .env.local         → machine-specific overrides (gitignored)
#   .env.production    → production defaults
#   .env.development   → development defaults (or .env.dev)
#   .env               → shared defaults (fallback)
#
# Tip: Copy this file to .env.local for local development

# Server
PORT=8040
HOST=0.0.0.0
NODE_ENV=development

# Better Auth
BETTER_AUTH_SECRET=your-32-character-minimum-secret-here
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# CORS - Allowed origins
# Options:
#   * = allow all origins (not recommended for production)
#   Comma-separated list = specific origins only
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/server

# Multi-tenant
ORG_HEADER=x-organization-id

# ── Alberta AT1 Net File transmission ────────────────────────────────────────
# Leaving TRA_NETFILE_ENDPOINT unset is the SAFE default: the filing gateway
# keeps its 503 stub, so no environment can record a return as transmitted that
# was never sent. Set it only once TRA has certified the software.
#
# TRA_NETFILE_ENDPOINT=https://<host>/CITNetFile-PublicWebServices-context-root/CITReturnFilingSoap12HttpPort
# TRA_NETFILE_TIMEOUT_MS=60000

# The transmitter identity on the EDI schedule. TRA issues the Software
# Certification Code at certification; until then the dev placeholder is used.
# TRA_SOFTWARE_CERT_CODE=AB0000
# TRA_WS_VERSION=0.0.1
# TRA_SERIAL=SR_DEV
# TRANSMITTER_LEGAL_NAME=
# TRANSMITTER_EMAIL=
